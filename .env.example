# ─── Database (shared with uniflexstore.com — same Neon Postgres) ───────────
# See prisma.config.ts / prisma/schema.prisma for why db push/migrate must
# NEVER be run from this project against this database.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# ─── Auth.js v5 ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# ─── Cloudinary (CRM document uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@uniflexlogistics.com

# ─── Logistics lead notification recipient ────────────────────────────────────
LOGISTICS_LEAD_EMAIL=dispatch@uniflexlogistics.com

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
